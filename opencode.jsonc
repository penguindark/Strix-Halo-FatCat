{
  "$schema": "https://opencode.ai/config.json",

  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" }
  ],

  "providers": {

    "ds4": {
      "name": "ds4.c (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.0.5:8000/v1",
        "apiKey": "dsv4-local"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (ds4.c local)",
          "limit": {
            "context": 100000,
            "output": 384000
          }
        }
      }
    },

    "halogen": {
      "name": "halogen-flash (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "none"
      },
      "models": {
        "Qwen3.8-Flash-Next-UD-IQ4_XL-262K": {
          "name": "Qwen3.8-Halogen-262K",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },

    "crucible": {
      "name": "Crucible",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.0.5:8080/v1",
        "apiKey": "local" // Crucible non richiede auth, ma serve una stringa dummy per il client
      },
      "models": {
        // Sostituisci "default" con l'ID restituito dal curl al passo 2 se diverso
        "crucible": {
          "name": "Crucible Strix Halo",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },


    "llama.cpp": {
      "name": "llama-server (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.0.5:8080/v1"
      },
      "models": {
        "Qwen3.8-Flash-Next-UD-IQ4_XL-262K": {
          "name": "Qwen3.8-Flash-Next-UD-IQ4_XL-262K",
          "limit": {
            "context": 128000,
            "output": 128000
          },
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "Qwen3.8-Flash-Next-UD-IQ4_XS-128K": {
          "name": "Qwen3.8-Flash-Next-UD-IQ4_XS-128K",
          "limit": {
            "context": 128000,
            "output": 128000
          },
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "Qwen3.8-Flash-Next-UD-IQ4_XS-128K-MTP": {
          "name": "Qwen3.8-Flash-Next-UD-IQ4_XS-128K-MTP",
          "limit": {
            "context": 128000,
            "output": 128000
          },
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "Qwen3.6-27B-UD-Q8_K_XL_MTP_128K": {
          "name": "Qwen3.6-27B-UD-Q8_K_XL_MTP_128K",
          "limit": {
            "context": 128000,
            "output": 128000
          },
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "Qwen3.6-35B-A3B-UD-Q8_K_XL_MTP_128K": {
          "name": "Qwen3.6-35B-A3B-UD-Q8_K_XL_MTP_128K",
          "limit": {
            "context": 128000,
            "output": 128000
          },
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "Qwen3.6-27B-UD-Q8_K_XL_128K": {
          "name": "Qwen3.6-27B-UD-Q8_K_XL_128K",
          "limit": {
            "context": 128000,
            "output": 128000
          },
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "Qwen3.6-35B-A3B-UD-Q8_K_XL_128K": {
          "name": "Qwen3.6-35B-A3B-UD-Q8_K_XL_128K",
          "limit": {
            "context": 128000,
            "output": 128000
          },
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "Devstral-2-123B-Instruct-2512-UD-Q5_K_XL": {
          "name": "Devstral-2-123B-Instruct-2512-UD-Q5_K_XL",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        },
        "Mistral-Small-4-119B-2603-UD-Q5_K_XL": {
          "name": "Mistral-Small-4-119B-2603-UD-Q5_K_XL",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        },
        "Qwen3.5-27B-UD-Q8_K_XL": {
          "name": "Qwen3.5-27B-UD-Q8_K_XL",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        },
        "Qwen3.5-35B-A3B-UD-Q4_K_XL": {
          "name": "Qwen3.5-35B-A3B-UD-Q4_K_XL",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        },
        "Qwen3.5-122B-A10B-UD-Q5_K_XL_262K": {
          "name": "Qwen3.5-122B-A10B-UD-Q5_K_XL_262K",
          "limit": {
            "context": 128000,
            "output": 65536
          },
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
  // end providers
}
